# --- Database -------------------------------------------------------------
# Tenant-scoped app role (RLS enforced). Never a superuser.
DATABASE_URL=postgres://dsa_app_login:dsa_app_dev@localhost:5432/driving_school
# BYPASSRLS role: SaaS admin console, webhook routing, background jobs.
DATABASE_PLATFORM_URL=postgres://dsa_platform_login:dsa_platform_dev@localhost:5432/driving_school
# Owner used only by migrations.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5432/driving_school

# --- App ------------------------------------------------------------------
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-32+-random-bytes-base64
# 32-byte key (base64) for encrypting per-school secrets (WhatsApp tokens).
ENCRYPTION_KEY=
CRON_SECRET=change-me

# --- Email (Resend) -------------------------------------------------------
EMAIL_PROVIDER=console          # console | resend
RESEND_API_KEY=
EMAIL_FROM="Driving School <no-reply@example.com>"

# --- Payments (Stripe) ----------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) --------------------------------------------
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# --- AI agent (Claude) ----------------------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# --- docker compose only ----------------------------------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
PLATFORM_DB_PASSWORD=
APP_PORT=3000
